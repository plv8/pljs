CREATE TRUSTED LANGUAGE chain8 HANDLER k8 INLINE pljs_inline_handler VALIDATOR pljs_call_validator
CREATE FUNCTION k9() RETURNS language_handler AS $q$ return arguments[0]; $q$ LANGUAGE chain8
