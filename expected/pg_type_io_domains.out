(1 row)

ALTER DOMAIN tid_later_uuid ADD CONSTRAINT tid_later_uuid_nonzero
  CHECK (VALUE <> '00000000-0000-0000-0000-000000000000');
SELECT tid_later_uuid_ret('00000000-0000-0000-0000-000000000000');
