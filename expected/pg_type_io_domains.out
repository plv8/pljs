-- 6) The domain's checking state is built once per type, not once per value.
CREATE FUNCTION tid_mem(n int4) RETURNS SETOF tid_pos LANGUAGE pljs AS $$
  const used = () => Number(pljs.execute(
    "SELECT sum(total_bytes) AS b FROM pg_backend_memory_contexts")[0].b);

  for (let i = 1; i <= 1000; i++) pljs.return_next(i);

  const before = used();

  for (let i = 1; i <= n; i++) pljs.return_next(i);

  const grew_mb = (used() - before) / (1024 * 1024);

  pljs.elog(NOTICE, 'grew by less than 16MB: ' + (grew_mb < 16));
$$;
SELECT count(*) FROM tid_mem(50000);
NOTICE:  grew by less than 16MB: true
 count 
-------
 51000
(1 row)

-- 7) A generated column is NULL in a BEFORE trigger's NEW until the executor
-- computes it, so it is not checked against its domain.  A NOT NULL domain
-- rejected it, and a trigger returning NEW failed on every row.
CREATE TABLE tid_gen (a int4, b tid_nn GENERATED ALWAYS AS (a * 2) STORED);
CREATE FUNCTION tid_gen_trig() RETURNS trigger LANGUAGE pljs AS $$
  return NEW;
$$;
CREATE TRIGGER tid_gen_trig BEFORE INSERT OR UPDATE ON tid_gen
  FOR EACH ROW EXECUTE FUNCTION tid_gen_trig();
INSERT INTO tid_gen (a) VALUES (1);
UPDATE tid_gen SET a = 5;
SELECT * FROM tid_gen;
 a | b  
---+----
 5 | 10
(1 row)

-- 8) A CHECK constraint that converts a value of its own domain.  The nested
-- check shared the outer one's state and overwrote the VALUE the outer one
-- was checking, so 2000 passed.
CREATE FUNCTION tid_nest_chk(v int4) RETURNS bool LANGUAGE pljs AS $$
  if (v >= 1000) pljs.execute('SELECT $1::tid_nest AS x', [5]);
  return true;
$$;
CREATE DOMAIN tid_nest AS int4 CHECK (tid_nest_chk(VALUE) AND VALUE < 1000);
CREATE FUNCTION tid_nest_ret(i int4) RETURNS tid_nest LANGUAGE pljs AS $$
  return i;
$$;
SELECT 2000::tid_nest;
ERROR:  value for domain tid_nest violates check constraint "tid_nest_check"
SELECT tid_nest_ret(2000);
ERROR:  value for domain tid_nest violates check constraint "tid_nest_check"
SELECT tid_nest_ret(20);
 tid_nest_ret 
--------------
           20
(1 row)

-- The same through domain_in().
CREATE FUNCTION tid_nest_uuid_chk(v uuid) RETURNS bool LANGUAGE pljs AS $$
  if (v !== '00000000-0000-0000-0000-000000000005') {
    pljs.execute('SELECT $1::tid_nest_uuid AS x',
                 ['00000000-0000-0000-0000-000000000005']);
  }
  return true;
$$;
CREATE DOMAIN tid_nest_uuid AS uuid
  CHECK (tid_nest_uuid_chk(VALUE) AND
         VALUE = '00000000-0000-0000-0000-000000000005');
CREATE FUNCTION tid_nest_uuid_ret(s text) RETURNS tid_nest_uuid
  LANGUAGE pljs AS $$
  return s;
$$;
SELECT tid_nest_uuid_ret('00000000-0000-0000-0000-000000000009');
ERROR:  value for domain tid_nest_uuid violates check constraint "tid_nest_uuid_check"
SELECT tid_nest_uuid_ret('00000000-0000-0000-0000-000000000005');
          tid_nest_uuid_ret           
--------------------------------------
 00000000-0000-0000-0000-000000000005
(1 row)

-- 9) Any constraint change -- even a temporary table's CHECK -- makes the
-- typcache rebuild every domain's constraints, and domain_check() and
-- domain_in() then build them again without freeing the old ones.  A
-- function keeps its domains' checking state for its whole call, so a long
-- call that kept changing constraints grew with every change.
CREATE FUNCTION tid_churn(n int4) RETURNS SETOF tid_pos LANGUAGE pljs AS $$
  const used = () => Number(pljs.execute(
    "SELECT sum(total_bytes) AS b FROM pg_backend_memory_contexts " +
    "WHERE name IN ('PLJS Type I/O', 'PLJS Domain Check')")[0].b);
  const plan = pljs.prepare('SELECT $1 AS x', ['tid_uuid']);
  const churn = (count) => {
    for (let i = 0; i < count; i++) {
      pljs.execute('CREATE TEMP TABLE tid_churn (x int4 CHECK (x > 0))');
      pljs.execute('DROP TABLE tid_churn');
      pljs.return_next(1);
      plan.execute(['0192f1c2-3a4b-7c5d-8e6f-0a1b2c3d4e5f']);
    }
  };

  churn(10);

  const before = used();

  churn(n);

  pljs.elog(NOTICE, 'grew by less than 64kB: ' + (used() - before < 65536));
  plan.free();
$$;
SELECT count(*) FROM tid_churn(300);
NOTICE:  grew by less than 64kB: true
 count 
-------
   310
(1 row)

-- 10) A function's type state lives in its FmgrInfo, so none of it outlives
-- the query that called the function.  A cache kept for the life of the
-- backend had to find and free the entries for types that were dropped, such
-- as every temporary table's row type.
CREATE FUNCTION tid_rowarg(r anyelement) RETURNS int4 LANGUAGE pljs AS $$
  return 1;
$$;
CREATE PROCEDURE tid_row_churn(n int4) LANGUAGE plpgsql AS $$
BEGIN
  FOR i IN 1..n LOOP
    CREATE TEMP TABLE tid_churn_row (x int4);
    INSERT INTO tid_churn_row VALUES (1);
    PERFORM tid_rowarg(t) FROM tid_churn_row t;
    DROP TABLE tid_churn_row;
    COMMIT;
  END LOOP;
END $$;
CALL tid_row_churn(100);
SELECT count(*) AS type_state_left FROM pg_backend_memory_contexts
 WHERE name IN ('PLJS Type I/O', 'PLJS Domain Check');
 type_state_left 
-----------------
               0
(1 row)

-- 11) A procedure keeps its type state across COMMIT, and a constraint added
-- to a domain in one of its transactions applies in the next.
CREATE DOMAIN tid_txn_uuid AS uuid;
CREATE DOMAIN tid_txn_int AS int4;
CREATE PROCEDURE tid_txn() LANGUAGE pljs AS $$
  const zero = '00000000-0000-0000-0000-000000000000';
  const convert = () => {
    for (const [type, value] of [['tid_txn_uuid', zero], ['tid_txn_int', 0]]) {
      try {
        const x = pljs.execute('SELECT $1::' + type + ' AS x', [value])[0].x;
        pljs.elog(NOTICE, 'accepted ' + x);
      } catch (e) {
        pljs.elog(NOTICE, e.message);
      }
    }
  };

  convert();
  pljs.commit();
  pljs.execute("ALTER DOMAIN tid_txn_uuid ADD CONSTRAINT tid_txn_uuid_nonzero " +
               "CHECK (VALUE <> '" + zero + "')");
  pljs.execute('ALTER DOMAIN tid_txn_int ADD CONSTRAINT tid_txn_int_pos ' +
               'CHECK (VALUE > 0)');
  pljs.commit();
  convert();
$$;
CALL tid_txn();
NOTICE:  accepted 00000000-0000-0000-0000-000000000000
NOTICE:  accepted 0
NOTICE:  value for domain tid_txn_uuid violates check constraint "tid_txn_uuid_nonzero"
NOTICE:  value for domain tid_txn_int violates check constraint "tid_txn_int_pos"
-- 12) A range over a domain is not a domain, but its input function runs
-- the domain's, which keeps its checking state in the same way; case 9 was
-- fixed for domains alone.  range_in() rebuilt the domain's constraints in
-- the function's cache on every constraint change, and nothing freed them.
CREATE TYPE tid_pos_range AS RANGE (subtype = tid_pos);
CREATE FUNCTION tid_range_churn(n int4) RETURNS SETOF tid_pos_range
  LANGUAGE pljs AS $$
  const used = () => Number(pljs.execute(
    "SELECT sum(total_bytes) AS b FROM pg_backend_memory_contexts " +
    "WHERE name IN ('PLJS Type I/O', 'PLJS Domain Check')")[0].b);
  const churn = (count) => {
    for (let i = 0; i < count; i++) {
      pljs.execute('CREATE TEMP TABLE tid_churn (x int4 CHECK (x > 0))');
      pljs.execute('DROP TABLE tid_churn');
      pljs.return_next('[1,5)');
    }
  };

  churn(10);

  const before = used();

  churn(n);

  pljs.elog(NOTICE, 'grew by less than 64kB: ' + (used() - before < 65536));
$$;
SELECT count(*) FROM tid_range_churn(300);
NOTICE:  grew by less than 64kB: true
 count 
-------
   310
(1 row)

-- The state built again is built from the constraints as they are now.
CREATE DOMAIN tid_range_int AS int4;
CREATE TYPE tid_int_range AS RANGE (subtype = tid_range_int);
CREATE FUNCTION tid_range_later() RETURNS SETOF tid_int_range
  LANGUAGE pljs AS $$
  const next = (v) => {
    try {
      pljs.return_next(v);
    } catch (e) {
      pljs.elog(NOTICE, e.message);
    }
  };

  next('[-5,5)');
  pljs.execute('ALTER DOMAIN tid_range_int ADD CONSTRAINT tid_range_int_pos ' +
               'CHECK (VALUE > 0)');
  next('[-5,5)');
  next('[1,5)');
$$;
SELECT * FROM tid_range_later();
NOTICE:  value for domain tid_range_int violates check constraint "tid_range_int_pos"
 tid_range_later 
-----------------
 [-5,5)
 [1,5)
(2 rows)

DROP FUNCTION tid_range_churn, tid_range_later;
DROP TYPE tid_pos_range, tid_int_range;
DROP DOMAIN tid_range_int;
DROP TABLE tid_tbl, tid_spi, tid_gen;
DROP PROCEDURE tid_row_churn, tid_txn;
DROP FUNCTION tid_uuid_seen, tid_uuid_ret, tid_uuid_0192_ret, tid_mood_ret,
              tid_acl_echo, tid_ints_push, tid_ints_empty, tid_pair_bump,
              tid_pair_bad, tid_nn_uuid_null, tid_nn_uuid_sentinel,
              tid_nn_ts_nan, tid_nn_array, tid_pos_array, tid_row_ret,
              tid_row_set, tid_tbl_trig, tid_jsonb_set, tid_ints_set,
              tid_later_ret, tid_later_null, tid_later_uuid_ret, tid_mem,
              tid_gen_trig, tid_nest_ret, tid_nest_uuid_ret, tid_churn,
              tid_rowarg;
DROP TYPE tid_row;
DROP DOMAIN tid_uuid_0192, tid_uuid, tid_good_mood, tid_acl, tid_pos,
            tid_ints, tid_pos_pair, tid_nn, tid_nn_uuid, tid_nn_ts, tid_jsonb,
            tid_later_renamed, tid_later_uuid, tid_nest, tid_nest_uuid,
            tid_txn_uuid, tid_txn_int;
DROP FUNCTION tid_nest_chk, tid_nest_uuid_chk;
DROP TYPE tid_mood, tid_pair;
